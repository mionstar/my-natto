{
  "name": "my-natto",
  "version": "1.0.0",
  "description": "納豆の冷蔵庫残数を管理するPWA",
  "type": "module",
  "scripts": {
    "build": "npm run build:check && npm run build:js",
    "build:js": "esbuild src/app.ts --outfile=dist/app.js --bundle --minify --target=es2020 --format=esm",
    "build:check": "tsc --noEmit",
    "dev": "esbuild src/app.ts --outfile=dist/app.js --bundle --target=es2020 --format=esm --watch",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' '*.json' '*.css' '*.html'",
    "format:check": "prettier --check 'src/**/*.ts' '*.json' '*.css' '*.html'"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.3.0",
    "prettier": "^3.4.0"
  }
}
